# GitHub Authentication
# Get your personal access token from: https://github.com/settings/tokens
# Create a fine-grained token with access ONLY to your demo repository
# Required permissions: Contents (RW), Issues (RW), Pull Requests (RW)
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# Repository Configuration
# The repository should already exist on GitHub
REPO_NAME=ai-dummy-app
REPO_DESCRIPTION="Demo SaaS app for MCP blog - AI-powered content platform"
REPO_VISIBILITY=public

# Project Configuration
PROJECT_NAME="Q4 2025 Sprint - Week 2"
PROJECT_DESCRIPTION="Active sprint board showing realistic context switching scenarios"

# Team Members (comma-separated)
TEAM_BACKEND=dev-backend-sarah,dev-backend-mike
TEAM_FRONTEND=dev-frontend-alex
TEAM_AI=dev-ai-priya
MANAGERS=pm-product-lisa,eng-lead-platform-amy
